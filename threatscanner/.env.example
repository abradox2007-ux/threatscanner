# Copy this file to .env and fill in your values
# The app works without any API keys (heuristics only)
# Adding keys unlocks Google Safe Browsing and VirusTotal checks

# --- Google Safe Browsing API (free)
# Get key: https://console.cloud.google.com → APIs & Services → Safe Browsing API
SAFE_BROWSING_API_KEY=

# --- VirusTotal API (free tier: 4 req/min)
# Get key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# --- Redis (optional — falls back to in-memory rate limiter without it)
REDIS_URL=redis://localhost:6379

# --- Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# --- Max upload file size (bytes)
MAX_UPLOAD_BYTES=10485760
